{
  "openapi": "3.1.0",
  "info": {
    "title": "webhook-recovery",
    "summary": "Fair backlog burndown and consumer-defined replay policy after a provider outage.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness plus a real database round-trip.\n\nDeliberately still 200 when the database is down: the process *is* up, and a\nplatform health check that restarts the api because Postgres blinked turns\none outage into two. The ``db`` field is what to alert on.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation": {
      "post": {
        "summary": "Create Simulation",
        "description": "Create a simulation and seed its cast, in one transaction.\n\nSeeding belongs here because fan-out reads ``subscription``: a simulation\nwith no consumers accepts events and delivers them to nobody.\n\nCreating a simulation *is* Reset. Everything is namespaced by\n``simulation_id``, so runs persist side by side and one can be left running\nwhile another starts.",
        "operationId": "create_simulation_api_simulation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SimulationCreate"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation/{simulation_id}": {
      "get": {
        "summary": "Read Simulation",
        "operationId": "read_simulation_api_simulation__simulation_id__get",
        "parameters": [
          {
            "name": "simulation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Simulation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Patch Simulation",
        "description": "Pause / resume / change speed / flip fair drain.\n\nPause, resume and speed change are all epoch rewrites -- one shared piece of\narithmetic in ``app.core.clock``, applied here and nowhere else. The order\nmatters: the speed change is applied to the *post-status* config, so\npausing and speeding up in one request behaves like doing them in sequence.",
        "operationId": "patch_simulation_api_simulation__simulation_id__patch",
        "parameters": [
          {
            "name": "simulation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Simulation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation/{simulation_id}/event": {
      "post": {
        "summary": "Create Event",
        "description": "Ledger one event and fan it out to every subscribed consumer.\n\nIn production the callers here are the provider's own internal services. In\nthe demo a background task in this same process plays them -- through\n``ingest_events`` directly rather than back through this route, which is the\nsame code path without a loopback socket. This route is the real interface,\nand that is the part of the claim that matters.",
        "operationId": "create_event_api_simulation__simulation_id__event_post",
        "parameters": [
          {
            "name": "simulation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Simulation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation/{simulation_id}/consumer": {
      "get": {
        "summary": "List Consumers",
        "description": "Consumers with their live counters, seeded at simulation creation.",
        "operationId": "list_consumers_api_simulation__simulation_id__consumer_get",
        "parameters": [
          {
            "name": "simulation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Simulation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConsumerRead"
                  },
                  "title": "Response List Consumers Api Simulation  Simulation Id  Consumer Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation/{simulation_id}/metrics": {
      "get": {
        "summary": "Read Metrics",
        "operationId": "read_metrics_api_simulation__simulation_id__metrics_get",
        "parameters": [
          {
            "name": "simulation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Simulation Id"
            }
          },
          {
            "name": "since_bucket",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Return buckets strictly greater than this.",
              "default": -1,
              "title": "Since Bucket"
            },
            "description": "Return buckets strictly greater than this."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulation/{simulation_id}/decisions": {
      "get": {
        "summary": "Read Decisions",
        "description": "The most recent terminal decisions, newest first.\n\nDeliberately not cursored: ``delivery.id`` is assigned at ingest, not at\ncompletion, so a ``since_id`` cursor over it would silently skip decisions.",
        "operationId": "read_decisions_api_simulation__simulation_id__decisions_get",
        "parameters": [
          {
            "name": "simulation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Simulation Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionsPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/process": {
      "get": {
        "summary": "List Processes",
        "description": "Live workers and conductors.\n\nLiveness is this ``WHERE`` clause and nothing else. There is no reaper:\nstale rows from prior deploys accumulate harmlessly and are never read,\nwhich is what keeps \"nothing in the delivery path consults it\" literally\ntrue rather than approximately true.",
        "operationId": "list_processes_api_process_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProcessRead"
                  },
                  "type": "array",
                  "title": "Response List Processes Api Process Get"
                }
              }
            }
          }
        }
      }
    }
  },
