            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "delivery_id",
          "consumer_id",
          "consumer_name",
          "event_type",
          "entity_key",
          "state",
          "terminal_reason",
          "attempt_count",
          "occurred_at",
          "completed_at"
        ],
        "title": "DecisionRead",
        "description": "One terminal decision, for the event feed.\n\nNewest-first, and the client *replaces* rather than appends -- see\n:class:`DecisionsPage`."
      },
      "DecisionsPage": {
        "properties": {
          "simulation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Simulation Id"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionRead"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "required": [
          "simulation_id",
          "decisions"
        ],
        "title": "DecisionsPage",
        "description": "Newest-first, replace-on-poll -- deliberately not a cursor.\n\n``delivery.id`` is assigned at *ingest*, not at completion, so it is not\nmonotonic in decision order: a ``?since_id=`` cursor over it would silently\nskip decisions. A properly completion-ordered cursor needs a dedicated\nsequence, which is real work for a feed capped at ~50 rows. At a 500ms poll,\nreplace-on-poll is visually identical to appending."
      },
      "DeliveryState": {
        "type": "string",
        "enum": [
          "pending",
          "ready",
          "in_flight",
          "delivered",
          "expired",
          "superseded",
          "failed"
        ],
        "title": "DeliveryState",
        "description": "The delivery lifecycle (TECHNICAL_DESIGN.md \u00a7Delivery Lifecycle).\n\n``expired`` and ``superseded`` are decided by the conductor and never reach\na worker."
      },
      "EventCreate": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 64,
            "title": "Event Type"
          },
          "entity_key": {
            "type": "string",
            "maxLength": 128,
            "title": "Entity Key"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type",
          "entity_key"
        ],
        "title": "EventCreate",
        "description": "One event from the provider.\n\n``occurred_at`` is deliberately not a field: it is server-assigned from the\nsimulation's virtual clock. Letting a caller set it would let them backdate\nan event past a staleness bound, and staleness is a policy the *consumer*\nowns."
      },
